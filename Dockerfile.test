# syntax=docker/dockerfile:1.7
# Test runner image — source is mounted at /workspace via compose volume.
# Not for production: ships uv, runs as non-root to match permission-test expectations.
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim
# fasttext-predict (multilingual extra) has no CPython 3.14 wheel on PyPI, only an sdist. Build the wheel once
# into /wheelhouse and purge the compiler in the same layer; the compose commands install it after `uv sync`.
# Remove this once PyPI carries a cp314 wheel.
RUN apt-get update && apt-get install -y --no-install-recommends git g++ && \
    uvx pip wheel --no-deps --wheel-dir /wheelhouse "fasttext-predict>=0.9.2.4" && \
    apt-get purge -y g++ && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
RUN useradd --uid 1000 --create-home --shell /bin/sh runner && \
    mkdir -p /cache/uv /venv /tmp/archon-test/models && \
    chown -R runner:runner /cache/uv /venv /tmp/archon-test
USER runner
WORKDIR /workspace
ENV PATH="/venv/bin:$PATH" \
    HOME=/home/runner \
    ARCHON_SEARCH_CONTAINER=1 \
    ARCHON_SEARCH_DATA_DIR=/tmp/archon-test \
    # Persistent named volume so uv sync survives container restarts.
    UV_PROJECT_ENVIRONMENT=/venv \
    UV_CACHE_DIR=/cache/uv \
    # `uv sync` skips fasttext-predict (compose installs the prebuilt /wheelhouse wheel instead), and a
    # later `uv run` re-sync would try to build it from the sdist: skip that re-sync.
    UV_NO_SYNC=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
