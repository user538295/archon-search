# archon-search docker-compose environment overrides.
#
# Copy this file to `.env` next to `docker-compose.yml` and edit the
# values you want to override. Compose reads `.env` automatically.

# Docker image to use for every service.
# Pin to a specific release tag for reproducible dev-UAT environments.
# REQUIRED before first use: replace TAG with an actual release tag
# (e.g. 25.6.1) — the literal string "TAG" is not a valid image tag.
ARCHON_SEARCH_IMAGE=ghcr.io/user538295/archon-search:TAG

# Alternative: use a locally-built image instead of the GHCR release
# (mutually exclusive with the line above — comment one out when using
# the other; handy when iterating on the Dockerfile).
# ARCHON_SEARCH_IMAGE=archon-search:latest

# API key override.
#
# MULTI-INSTANCE WARNING: Do NOT set ARCHON_SEARCH_API_KEY here when
# running multiple instances. docker-compose.yml interpolates this
# variable into every service, so setting it here silently gives all
# services the same key, defeating per-instance key isolation. Leave it
# unset and let each instance auto-generate its own key from its own
# data volume.
#
# SINGLE-INSTANCE: You MAY set this when running a single Docker service
# to pin the key across container recreates — previously-issued tokens
# will keep working after a `docker compose up` restart. Bearer token
# clients must send it as `Authorization: Bearer <key>`. If unset, the
# server auto-generates a key on first start and writes it to
# `/data/.search.env` inside the container; subsequent starts read the
# existing key from that file (as long as the data volume persists).
# To use this, uncomment the line below and set a lowercase hex key.
# ARCHON_SEARCH_API_KEY=
