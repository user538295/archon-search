# archon-search docker-compose environment overrides.
#
# Copy this file to `.env` next to `docker-compose.yml` and edit the
# values you want to override. Compose reads `.env` automatically.

# Bearer token clients must send as `Authorization: Bearer <key>`.
# If unset, the server auto-generates one on every fresh start and
# writes it to `/data/.search.env` inside the container — fine for
# dev, but in production you almost always want to pin it here so
# previously-issued tokens keep working across container recreates.
ARCHON_SEARCH_API_KEY=your-key-here

# Override the image used by every service. The default points at the
# GHCR-published release image; uncomment the line below to use a
# locally-built image instead (handy when iterating on the Dockerfile).
# ARCHON_SEARCH_IMAGE=archon-search:latest
