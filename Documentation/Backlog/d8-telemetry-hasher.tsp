namespace TelemetryHasherContract;

/** Salt stored at get_data_dir() / ".telemetry-salt" (mode 0o600, 32 raw bytes). */
model SaltFile {
  /** Absolute path to the salt file — resolved via get_data_dir(). */
  path: string;

  /** 32 bytes of cryptographic-random entropy, generated by secrets.token_bytes(32). */
  content: bytes;
}

/** Result of the salt-load lifecycle operation. */
model SaltLoadResult {
  /** Loaded salt bytes; null if load failed and server fell back to no-hashing. */
  salt: bytes | null;

  /**
   * True if a new salt was generated this startup (metric continuity broken from this point).
   * Caller MUST log a WARNING when this is true.
   */
  generated: boolean;

  /**
   * True if the salt file existed but was unreadable (permission error, corrupt, etc.).
   * Caller MUST log an ERROR and fall back to hash_doc_ids=false for this session.
   */
  read_error: boolean;
}

/** Loaded once at app startup; stored on app.state for use by route handlers. */
model AppStateSalt {
  /** null means hashing is disabled (either config off, or read_error fallback). */
  salt_bytes: bytes | null;
}

interface SaltLifecycle {
  /**
   * Load (or generate) the salt at startup.
   * - If hash_doc_ids=false: return AppStateSalt{salt_bytes=null} immediately.
   * - If file missing: generate 32 random bytes, write with mode 0o600, log WARNING.
   * - If file readable: load it.
   * - If file unreadable: log ERROR, return AppStateSalt{salt_bytes=null} (no crash).
   */
  load(hashDocIdsEnabled: boolean): AppStateSalt;
}

interface TelemetryHasher {
  /**
   * HMAC-SHA256(salt, doc_id_hex) → 64-character lowercase hex string.
   * Pure function: same (salt, doc_id) always returns the same output.
   * Different inputs always return different outputs (collision-resistant).
   * Never raises; salt must be non-null (caller guards).
   */
  hashDocId(salt: bytes, docIdHex: string): string;
}
