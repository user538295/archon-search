/**
 * DELTA-ONLY CONTRACT — Not the full /explain schema.
 *
 * This file documents only the E1c additions to POST /explain.
 * The authoritative full schema is tests/server/openapi_snapshot.json
 * (regenerated by BE-9 via `uv run --python 3.12 pytest tests/server/test_openapi_snapshot.py --update-openapi-snapshot`).
 *
 * ExplainScoreBreakdown here is simplified (3 fields vs 8 in the real schema:
 * vector_rank, vector_score, vector_score_kind, fts_rank, fts_score,
 * fts_score_kind, rrf_score, reranker_score).
 * ExplainResponse here omits routing, excluded_collections, stage_timings_ms,
 * rag_fusion_queries_used/attempted/failure_reason/sub_queries fields.
 * ExplainResult omits updated_at, ingested_by, metadata, acl fields.
 * These omissions are intentional — this contract focuses on E1c additions only.
 *
 * Field naming: this TypeSpec uses camelCase. The live API uses snake_case.
 * camelCase here is TypeSpec convention; snake_case is enforced by Pydantic's
 * model_config alias generator in production.
 */
import "@typespec/http";
using Http;

@service(#{ title: "E1C Explain Graph Provenance API" })
namespace E1cExplainGraphProvenance;

/** Allowed graph retrieval modes — mirrors E1a/E1b SearchRequest.graphMode. */
union GraphMode {
  naive: "naive",
  local: "local",
  global: "global",
}

/**
 * One step in the traversal chain from query entity → graph → chunk.
 * At least one of relationship, communityId, or chunkId MUST be set;
 * a step with all three null is invalid and rejected by the server.
 */
model TraversalStep {
  /** Entity name at this step. */
  entity: string;
  /** Stable SHA-256 hex entity identifier. */
  entityId: string;
  /** Typed relationship edge (naive mode: USES, DEPENDS_ON …; null for community steps). */
  relationship: string | null;
  /** Community identifier (local/global mode; null for naive steps). */
  communityId: string | null;
  /** Present only on the terminal step — the chunk this path leads to. */
  chunkId: string | null;
}

/**
 * Full traversal chain attached to a graph-retrieved explain result.
 * steps is ordered: query entity first, terminal chunk step last.
 * steps: [] (empty) signals a graph-retrieval bug; graph_provenance: null means
 * the chunk was retrieved by standard hybrid search.
 */
model GraphProvenance {
  steps: TraversalStep[];
}

model ExplainScoreBreakdown {
  vector: float32;
  fts: float32;
  reranker: float32 | null;
}

model ExplainResult {
  docId: string;
  chunkId: string;
  sourcePath: string;
  text: string;
  score: float32;
  breakdown: ExplainScoreBreakdown;
  fileType: string;
  indexedAt: string;
  language: string;
  collection: string;
  /** Null when the chunk was retrieved via standard hybrid search. */
  graphProvenance: GraphProvenance | null;
}

model ExplainNearMiss {
  docId: string;
  chunkId: string;
  sourcePath: string;
  score: float32;
  breakdown: ExplainScoreBreakdown;
  collection: string;
  // No graphProvenance — near misses are secondary diagnostics; provenance omitted by design.
}

model ExplainRequest {
  query: string;
  collection?: string | null;
  collections?: string[] | null;
  topK?: int32;
  rerank?: boolean;
  hyde?: boolean;
  ragFusion?: boolean;
  /**
   * Null (default) = standard explain, no graph retrieval.
   * Caller must opt in explicitly — consistent with hyde and ragFusion.
   */
  graphMode?: GraphMode | null;
}

model ExplainResponse {
  rerank: boolean;
  collection: string;
  aclFiltered: boolean;
  results: ExplainResult[];
  nearMisses: ExplainNearMiss[];
  embeddingModel: string;
  hydeApplied: boolean;
  ragFusionApplied: boolean;
  /**
   * Which graph mode the pipeline attempted to execute. Set to the requested mode
   * when graph retrieval ran, regardless of whether it yielded results.
   * Null only when graphMode was null (standard explain, no graph path entered).
   * When non-null, hydeApplied and ragFusionApplied are always false.
   */
  graphModeApplied: GraphMode | null;
}

/**
 * Plain string detail — matches the /search route-layer guard format exactly.
 * No `code` field. Body: {"detail": "graph_mode requires [graph] enabled=true in server config"}
 */
model GraphNotEnabledError {
  detail: string;  // "graph_mode requires [graph] enabled=true in server config"
}

model GraphCommunitiesNotBuiltError {
  detail: {
    code: "graph_communities_not_built";
    message: string;
  };
}

@route("/explain")
interface Explain {
  @post explain(@body body: ExplainRequest):
    | ExplainResponse
    | {
        @statusCode statusCode: 422;
        @body body: GraphNotEnabledError;
      }
    | {
        @statusCode statusCode: 422;
        @body body: GraphCommunitiesNotBuiltError;
      };
}
