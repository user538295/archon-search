# archon-search.toml — configuration for the archon-search server
#
# Default location: ~/.archon-search/archon-search.toml
# Override the path with the ARCHON_SEARCH_CONFIG environment variable
# (absolute or tilde-prefixed).
#
# All values shown are the defaults; omit any section or key to use its default.
#
# Authentication:
#   The API key for the HTTP server is read from ~/.archon-search/.search.env
#   (file mode 600 on POSIX). Override the file location with
#   ARCHON_SEARCH_KEY_FILE, or supply the key directly via the
#   ARCHON_SEARCH_API_KEY environment variable (takes precedence over the file).

[mcp]
# Mount the MCP endpoint at /mcp on the same port as REST (default: true).
# When true, FastMCP's streamable-HTTP transport is bound inside the existing
# FastAPI app — no second port or process is required.
# Set to false to prevent the /mcp mount from being created; GET /status and
# GET /health will return the mcp field as null.
enabled = true

[auth]
# Grace period for key rotation (seconds). When > 0, the old default key gets
# expires_at = now + rotate_grace_seconds after a successful `key rotate` or
# POST /keys/rotate call, allowing in-flight requests to drain before rejection.
# Set to 0 (the default) for immediate revocation of the old key.
# The POST /keys/rotate request body grace_seconds field overrides this default
# for an individual rotation call.
# rotate_grace_seconds = 0

[ingest]
# Maximum file size allowed for ingest operations. 0 = no limit (default).
# When set to a positive integer, any single file whose size exceeds this limit
# is rejected with a clear error naming the file size, the limit, and this key.
# Use this to protect memory-constrained hosts from unexpectedly large files.
# Directory ingest: oversized files produce per-file errors; the batch continues.
# Negative values are invalid and raise a ConfigError at server start.
# max_file_mb = 0  # 0 = no limit

[server]
# Bind address and port for the HTTP API.
host = "127.0.0.1"
port = 8765

[database]
# On-disk location for the vector store and metadata.
db_path = "~/.archon-search/search"
# Sentence-transformers embedding model used for indexing and queries.
embedding_model = "BAAI/bge-small-en-v1.5"
# Cross-encoder used to rerank candidate results before returning them.
reranker_model = "Xenova/ms-marco-MiniLM-L-6-v2"
# Target chunk size (tokens) when splitting documents during ingestion.
chunk_size = 512
# If chunk_size changes, automatically reindex affected collections on startup.
auto_reindex_on_chunk_size_change = true
# ONNX Runtime execution providers for the embedding/reranker models.
# providers = []                               # CPU (default)
# providers = ["CUDAExecutionProvider"]        # NVIDIA GPU
# providers = ["CoreMLExecutionProvider"]      # Apple Silicon

# Install profile ("minimal" | "balanced" | "max"; empty = legacy install).
# Set by `archon-search install --profile <name>`; used by config.py to record which
# profile was chosen at install time. Leave empty to preserve pre-C0 manual config.
profile = ""
# Use multilingual models (requires Jina CC-BY-NC-4.0 license acceptance for balanced/max).
# Set to true by `archon-search install --multilingual`.
multilingual = false
# Minimum fasttext confidence score [0.0 exclusive, 1.0 inclusive] for language detection.
# Results below this threshold are stored as "unknown" instead of a language code.
# language_detection_confidence_threshold = 0.7

# Maximum number of embedder model instances to cache in memory (LRU cache, minimum 1).
# embedder_cache_size = 3

# If true, pre-warm all distinct embedding models at server startup (eager loading).
# Eliminates the ~5–15s first-query latency by loading models before any request arrives.
# Set interactively via `archon-search wizard` or with the `--eager-load / --no-eager-load` flag.
# eager_load_embedders = false

# Timeout (seconds) for the background model-validation task that runs at server startup.
# Validation probes the configured embedding/reranker models and ONNX providers, then
# surfaces the result in GET /status and GET /ready without blocking startup or queries.
# Must be > 0; values <= 0 are rejected with a warning and fall back to the default 60.
# validation_timeout_seconds = 60

# Number of results returned per query (top-K return set).
# Set via `archon-search wizard --top-k N` (valid wizard range: 1–100).
# top_k_return = 5

# Candidate pool fetched from the vector + FTS stores before reranking.
# Set automatically by the wizard as max(15, 3 × top_k_return) when --top-k is passed.
# top_k_retrieve = 15

# Trigger a full centroid recompute after this many mutations (adds + deletes) since last recompute.
centroid_recompute_threshold = 10000

[search]
# Multi-collection fan-out execution bounds (B3). These govern the
# server-side search_many primitive — they control the fan-out execution
# window, not the storage schema.
# Maximum number of collections accepted in one multi-collection request.
max_fanout = 8
# Per-leg candidate pool kept by local RRF score before the global merge.
fanout_leg_trim = 40
# Whole-fan-out timeout (seconds); exceeding it returns HTTP 504.
fanout_timeout_seconds = 30.0
# Operator ceiling on the top_k value accepted by POST /search and POST /explain.
# Requests exceeding this limit are rejected, protecting the server from
# expensive large-k reranking requests. Default: 100.
# top_k_max = 100

[routing]
# Number of collections considered by the router before parallel search.
routing_shortlist_size = 8
# Minimum router confidence required to dispatch a query to a collection.
routing_confidence_threshold = 0.30
# Maximum number of collections searched concurrently per query.
max_parallel_collections = 3
# Routing strategy: "centroid" (pure vector centroid similarity) or
# "hybrid" (blends centroid score with description-embedding cosine similarity).
# Use "hybrid" for corpora with distinct domain boundaries to improve routing precision.
# Set interactively via `archon-search wizard` or with the `--routing-strategy {centroid,hybrid}` flag.
routing_strategy = "centroid"
# Weight [0.0, 1.0] for description-embedding cosine in hybrid routing.
# Ignored when routing_strategy = "centroid".
routing_description_weight = 0.3

[collections]
# Collections that are always included in every search, regardless of routing.
pinned_collections = []
# Static list of collection definitions (name + source path). Leave empty to
# manage collections via the HTTP API.
collections = []
# Watch source directories and reindex on change.
# When true, the watchdog monitors collection source paths and triggers re-ingest on file changes.
# Set interactively via `archon-search wizard` or with the `--watch / --no-watch` flag.
watch = false

[jobs]
# Maximum number of export, import, and migration jobs that may run concurrently.
# Existing ingest/reindex/delete jobs are unaffected — they dispatch immediately.
# MigrationJob (D3) respects this same limit: rewrite-kind migrations queue behind
# any in-flight export/import jobs at the configured concurrency ceiling.
max_concurrent_bulk = 1
# Number of documents written between progress checkpoints.
# Lower values produce more granular progress updates and finer resume granularity;
# higher values reduce write amplification on the job store.
checkpoint_interval = 100

[logging]
level = "INFO"
# Set to "" to disable file logging (stderr only — useful in containers).
# Upgrade note: the non-empty default activates file logging automatically;
# set log_file = "" explicitly to opt out.
log_file = "~/.archon-search/logs/archon-search.log"
# Log format: "text" (default) or "json" (structured JSON for log aggregators).
# Use "json" for container deployments and log aggregation pipelines (e.g., Datadog, Loki).
# Set interactively via `archon-search wizard` or with the `--log-format {text,json}` flag.
# format = "text"

# Number of rotated log files to retain (daily rotation at UTC midnight).
# 0 = never delete rotated files (they accumulate indefinitely).
# 1 = keep only 1 rotated file in addition to the current log file.
# backup_count = 7

[observability]
# Correlation-ID propagation and per-stage latency recording.
#
# When stage_timings_enabled = true (the default), each handled request binds
# a StageRecorder that accumulates blocked-coroutine wall times (perf_counter)
# for individual pipeline stages (embed, route, vector, fts, fuse, rerank,
# context, parse, persist). The timings appear in structured log lines as stage_timings_ms
# and in the response body of POST /explain and the MCP explain tool.
# Set to false to suppress stage_timings_ms from all responses.
stage_timings_enabled = true

# Name of the HTTP header used to carry the correlation ID.
# The middleware reads this header on inbound requests (validating it against
# ^[A-Za-z0-9._-]{1,128}$) and writes it on every response, including /health
# and 401 responses. Must be a non-empty string.
request_id_header = "X-Request-ID"

[hyde]
# HyDE (Hypothetical Document Embeddings) — optional dense-retrieval recall booster.
# Disabled by default.
#
# WARNING: setting enabled = true causes the raw query text to be sent to Anthropic's
# API servers on every request that includes hyde=true. Do not enable in air-gapped
# deployments or where data residency requirements apply.
#
# Prerequisites:
#   1. Install the optional dependency: pip install archon-search[hyde]
#   2. Set ANTHROPIC_API_KEY in the server's environment.
#
# When enabled = false (the default), hyde=true in a request is silently ignored and
# the standard query embedding is used (hyde_applied: false in the response).
enabled = false
# Claude model used to generate the hypothetical answer passage.
model = "claude-haiku-4-5-20251001"
# Per-request timeout (seconds) for the Anthropic API call. On timeout, the server
# falls back silently to the original query embedding (hyde_applied: false).
timeout_seconds = 10.0
# Per-process rate limit (requests per minute) for the Anthropic API. Requests that
# exceed this limit are answered with the fallback embedding (hyde_applied: false).
# In multi-worker deployments the effective rate is multiplied by worker count.
max_requests_per_minute = 60

[rag_fusion]
# RAG Fusion — optional multi-query recall booster using LLM-generated query variants.
# Disabled by default.
#
# WARNING: setting enabled = true causes the raw query text to be sent to Anthropic's
# API servers on every request that includes rag_fusion=true. Do not enable in air-gapped
# deployments or where data residency requirements apply.
#
# Prerequisites:
#   1. Install the optional dependency: pip install archon-search[rag_fusion]
#   2. Set ANTHROPIC_API_KEY in the server's environment.
#
# When enabled = false (the default), rag_fusion=true in a request is silently ignored and
# standard single-query search is used (rag_fusion_applied: false in the response).
#
# RATE LIMIT WARNING: [hyde].max_requests_per_minute + [rag_fusion].max_requests_per_minute
# must not exceed your Anthropic account rate limit — both features share the same API key.
# In multi-worker deployments, the effective rate per feature is multiplied by worker count.
enabled = false
# Claude model used to generate query variants.
model = "claude-haiku-4-5-20251001"
# Per-request timeout (seconds) for the Anthropic API call. On timeout, the server
# falls back silently to single-query search (rag_fusion_applied: false).
timeout_seconds = 10.0
# Per-process rate limit (requests per minute) for the Anthropic API. Requests that
# exceed this limit fall back to single-query search (rag_fusion_applied: false).
# In multi-worker deployments the effective rate is multiplied by worker count.
max_requests_per_minute = 60
# Number of LLM-generated query variants (not counting the original query).
# Total searches per request = num_queries + 1. Valid range: 1–5.
# NOTE: num_queries = 1 incurs LLM overhead for minimal benefit; consider using 2 or more.
num_queries = 2

[backup]
# Automated periodic backup of all collections.
# Disabled by default (interval_hours = 0).
#
# When interval_hours > 0, the server automatically exports each collection to
# a .tar.gz archive in output_dir/{namespace}/ at the configured interval.
# Archives are named {collection}.backup.{timestamp}.tar.gz and the `keep` most
# recent are retained; older archives are deleted automatically (rotation).
#
# Set interval_hours = 0 to disable scheduled backups entirely.
# interval_hours = 0
#
# Number of archive files to retain per collection. 0 = never rotate (archives accumulate).
# WARNING: interval_hours > 0 and keep = 0 will cause unbounded disk growth.
# keep = 7
#
# Collections to exclude from automatic backup. Accepts bare names (matches across
# all namespaces) or qualified namespace/collection names.
# exclude = []
# exclude = ["scratch", "tenants/staging"]
#
# Directory where backup archives are written.
# Empty string (the default) resolves to ~/.archon-search/backups/ at runtime.
# Must have at least 3 path components (e.g. /mnt/nfs/backups) to prevent
# rotation from scanning near-root directories.
# output_dir = ""

[maintenance]
# Automated in-process maintenance passes (FTS optimize, orphan cleanup, failed-ingest retry).
# Disabled by default (interval_hours = 0).
#
# When interval_hours > 0, the server runs a maintenance pass every interval_hours hours.
# When interval_hours = 0, no scheduled pass runs, but POST /maintenance/trigger still works.
#
# Set interval_hours = 0 to disable scheduled maintenance entirely.
# interval_hours = 0
#
# Enable FTS index optimization during each pass.
# fts_optimize = true
#
# Enable removal of orphaned chunks (chunks whose source_path no longer exists on disk).
# URL-sourced chunks are skipped.
# orphan_cleanup = true
#
# Enable automatic re-enqueue of failed IngestJobs within the retry age and attempt limits.
# failed_ingest_retry = true
#
# Enable automatic pruning of expired chunks (chunks whose expires_at < now_utc).
# Requires E2a schema migration (POST /collections/{name}/migrate) before chunks with TTL are stored.
# prune_expired_chunks = true
#
# Enable graph garbage-collection maintenance policy (removes orphaned graph nodes/edges
# whose source documents have been deleted from the collection).
# graph_gc = true
#
# Maximum number of retry attempts per source file per collection before giving up.
# retry_max_attempts = 3
#
# Only retry failed IngestJobs created within this many hours ago.
# retry_max_age_hours = 72
#
# Collections to exclude from maintenance passes. Accepts bare names (matches across
# all namespaces) or qualified namespace/collection names.
# exclude = []
# exclude = ["scratch", "tenants/staging"]

[graph]
# GraphRAG entity extraction and naive query expansion (E1a).
# Disabled by default. Requires the optional graph extras:
#   uv pip install 'archon-search[graph]'
# or:
#   pip install 'archon-search[graph]'
#
# NOTE (E1a/BE-1): The [graph] section is parsed at startup but the extraction
# runtime (GraphExtractor, GraphStore, pipeline hooks) ships in later BE tasks.
# Setting enabled = true before those tasks are deployed is a safe no-op:
# the flag is read, but no extraction occurs and no error is raised.
#
# When the full E1a slice is deployed: enabling and re-ingesting causes each
# ingested document's chunks to be entity-extracted into
# per-collection _archon_graph_{ns}__{col}_nodes / _archon_graph_{ns}__{col}_edges LanceDB tables.
# Adding graph_mode=naive to POST /search or the MCP search tool expands queries
# with first-degree graph-neighbour entity names before the normal hybrid search pipeline runs.
#
# IMPORTANT: enabling graph and then re-ingesting is required to populate graph tables.
# Existing chunks already stored before enabling graph will NOT be auto-extracted.
# Set enabled = true, then re-ingest all collections whose graph you want built.
#
# UPGRADE NOTE (E2d): graph table names now include the namespace prefix using a
# double-underscore separator (_archon_graph_{ns}__{col}_nodes). Tables created
# before E2d are orphaned after upgrade — delete them manually and re-ingest to
# rebuild graph data under the new namespace-scoped names.
#
# enabled = false

# Optional: Claude model used for LLM-based typed relationship extraction.
# When set, each ingest call attempts a typed extraction pass (USES, IMPLEMENTS, etc.)
# before falling back to spaCy co-occurrence edges on failure.
# NOTE: LLM extraction is a config-guarded stub in E1a — setting this key logs a WARNING
# and proceeds with spaCy-only extraction. Full LLM extraction is deferred to E1b.
# Requires ANTHROPIC_API_KEY in the server environment.
# extraction_model = "claude-haiku-4-5-20251001"

# Rough empirical edge-count threshold (integer, default 10,000) above which NetworkX
# in-memory graph traversal (full LanceDB scan per expansion call) becomes latency-noticeable
# (~100–500ms). When the edge count of a collection crosses this value during ingest,
# archon-search logs a WARNING and adds a migration hint to IngestResult.warnings.
# No automatic migration is performed in E1a; Kuzu backend migration is deferred to E1b.
# Adjust down if GET /status latency matters more than simplicity. Adjust up for large
# corpora where the latency is acceptable.
# backend_threshold_edges = 10000

# E1b community-detection fields
#
# leiden_resolution (float, default 1.0): Leiden algorithm resolution parameter.
# Higher values produce more, smaller communities. Must be > 0.
# Tune for your corpus — 1.0 is the standard default.
# leiden_resolution = 1.0

# max_community_size (int, default 10): Maximum number of entities per community.
# Communities larger than this are split by re-running Leiden at higher resolution
# on the oversized subgraph (up to 5 recursion levels). Must be >= 1.
# max_community_size = 10

# community_summary_chunks (int, default 3): Number of MMR-selected representative
# chunks per community. Also used as the context window size for optional LLM
# abstractive summarisation when extraction_model is set. Must be >= 1.
# community_summary_chunks = 3

# max_global_candidates (int, default 100): Operator cap on community representative
# chunks fed to the reranker in global mode (graph_mode=global on POST /search).
# Prevents reranker overload on large corpora. Must be > 0.
# max_global_candidates = 100

# E2b graph inspection fields
#
# max_inspection_nodes (int, default 5000): Operator ceiling on the number of nodes
# returned by GET /graph/{collection} and GET /graph/cross-collection. When the graph
# exceeds this limit, truncation fires (nodes are sorted by chunk_count desc, then
# entity_id asc, and capped at max_inspection_nodes). The truncated flag is set
# to true in the response when either the node cap or edge cap fires.
# max_inspection_nodes = 5000

# max_inspection_edges (int, default 25000): Operator ceiling on the number of edges
# returned by GET /graph/{collection} and GET /graph/cross-collection. Edges are
# filtered to those where both source_entity_id and target_entity_id survive the
# node truncation, then sorted by weight desc and id asc, and capped at
# max_inspection_edges. Must be > 0.
# max_inspection_edges = 25000

# E2d graph garbage-collection fields
#
# gc_rebuild_communities (bool, default true): Automatically rebuild communities after
# GC removes nodes. Keeps community membership current after document deletions.
# gc_rebuild_communities = true

# gc_rebuild_cpu_priority (str, default "low"): CPU priority for the community rebuild
# thread spawned after GC. Valid values: "low" (nice 10), "normal" (nice 0), "high"
# (nice -5). Per-thread CPU priority reduction is a Linux-only feature; on other
# platforms, os.setpriority() affects the entire process rather than just the rebuild
# thread, and a startup WARNING is logged when the GC rebuild pipeline is fully active.
# gc_rebuild_cpu_priority = "low"

[telemetry]
# Opt-in local query telemetry. Disabled by default.
#
# When enabled, each /search and /route call appends one JSON line to a daily
# file under log_dir. Only structural metadata is recorded (collection names,
# latency, result counts, etc.) — raw query text is never written to disk.
# Old files are pruned after retention_days.
# Set interactively via `archon-search wizard` or with the `--telemetry / --no-telemetry` flag.
enabled = false
retention_days = 30
log_dir = "~/.archon-search/search-logs"
# Hashed doc_id mode (D8): when true, result_doc_ids in JSONL telemetry entries are
# replaced with HMAC-SHA256 values keyed by a 32-byte salt stored at
# ~/.archon-search/.telemetry-salt (mode 600). Severs the mapping to raw
# filesystem paths in exported/shared logs. Default: false (raw path-derived hashes).
hash_doc_ids = false
# export_enabled = false   # reserved for a future remote-export feature; in v1
                           # the config loader logs a warning and silently
                           # coerces this to false. No external transmission
                           # occurs. Tracked as TEL-1 in
                           # Documentation/Architecture/530_technical_debt_refactoring_roadmap.md.
