#!/usr/bin/env python3
"""Container-side claude shim — proxies to the host claude-proxy service.

Mounted at /usr/local/bin/claude inside the dev container.
The proxy URL is configured via CLAUDE_PROXY_URL (default: host.docker.internal:18766);
the shared secret the proxy requires is read from CLAUDE_PROXY_TOKEN.
"""
import json
import os
import sys
import urllib.request

PROXY_URL = os.environ.get("CLAUDE_PROXY_URL", "http://host.docker.internal:18766")
TOKEN = os.environ.get("CLAUDE_PROXY_TOKEN", "")

data = json.dumps({"args": sys.argv[1:]}).encode()
req = urllib.request.Request(
    PROXY_URL,
    data=data,
    headers={"Content-Type": "application/json", "X-Claude-Proxy-Token": TOKEN},
)
try:
    resp = urllib.request.urlopen(req, timeout=120)
    sys.stdout.write(resp.read().decode())
    sys.exit(int(resp.headers.get("X-Exit-Code", "0")))
except Exception as exc:
    sys.stderr.write(f"claude-proxy error: {exc}\n")
    sys.exit(1)
